#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

UV_BIN="$(command -v uv || true)"
if [[ -z "${UV_BIN}" && -x "${ROOT}/.venv/bin/uv" ]]; then
    UV_BIN="${ROOT}/.venv/bin/uv"
fi
if [[ -z "${UV_BIN}" && -x "${HOME}/.local/bin/uv" ]]; then
    UV_BIN="${HOME}/.local/bin/uv"
fi
if [[ -z "${UV_BIN}" ]]; then
    echo "uv is not installed; run scripts/setup inside the dev container." >&2
    exit 1
fi

# Apply correctness rules to the legacy integration source without forcing a
# repository-wide reformat in the same change as the development environment.
"${UV_BIN}" run --frozen --no-sync ruff check \
    --select E9,F63,F7,F82 custom_components tests

# New test and tooling code follows the complete repository Ruff policy.
"${UV_BIN}" run --frozen --no-sync ruff check tests
"${UV_BIN}" run --frozen --no-sync ruff format --check tests
