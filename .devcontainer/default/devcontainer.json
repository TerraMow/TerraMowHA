{
  "name": "TerraMowHA (recommended)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  "initializeCommand": "bash scripts/prepare-devcontainer-host .devcontainer/default/devcontainer.json",
  "postCreateCommand": "bash scripts/setup",
  "appPort": ["8124:8123", "5678:5678"],
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONASYNCIODEBUG": "1"
  },
  "runArgs": [
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/proxy.env"
  ],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "charliermarsh.ruff",
        "github.vscode-pull-request-github",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml"
      ]
    }
  }
}
